<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Terminal colour palettes, owned by `BusterClaw.TerminalTheme` and read
          here by `assets/js/lib/theme.js`. In the head rather than on the picker
          because a terminal can mount on a page that has no picker, so the data
          has to be wherever a terminal is. A `<meta>` rather than an inline
          `<script type="application/json">`: this app's CSP is `script-src 'self'`
          with nothing inline, and while a JSON data block is not executed and so
          not actually blocked, the repo deliberately removed its last inline
          script to drop the nonce — re-adding a tag that merely looks like a
          violation buys nothing. --%>
    <meta name="bc-term-palettes" content={BusterClaw.TerminalTheme.payload_json()} />
    <.live_title default="Buster Claw" suffix=" · Buster Claw" phx-no-format>{assigns[:page_title]}</.live_title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/archivo-900.woff2"}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/ibm-plex-sans-400.woff2"}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/ibm-plex-mono-500.woff2"}
      crossorigin="anonymous"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Render-blocking on purpose: the theme must be on `<html>` before the
          body paints, or it flashes. That is why this is its own bundle and not
          part of the deferred app.js — and why it is a file rather than an
          inline script, which is what let the CSP drop `'nonce-…'`. --%>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- App-wide fired-notification modal, sticky so it persists across page nav. --%>
    {live_render(@conn, BusterClawWeb.NotifyLive, sticky: true, id: "notify-global")}
    <%!-- App-wide sound effects (SOUND_ROADMAP Phase 1): event chimes ring on
          whatever page is showing. Renders nothing visible. --%>
    {live_render(@conn, BusterClawWeb.SoundBoardLive, sticky: true, id: "sound-board-global")}
  </body>
</html>
